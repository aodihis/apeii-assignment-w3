// use prisma-next
enum RequestStatus {
  @@type("pg/text@1")
  PENDING = "pending"
  FINNISH = "finnish"
}
model PlanRequest {
  id Uuid @id @default(uuid())
  goal      String
  equipment String
  availableTime String
  status  RequestStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAtString()
}

model PlanResult {
  id Uuid @id @default(uuid())
  plan      String
  requestId Uuid
  request PlanRequest @relation(fields: [requestId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAtString()
}
