// use prisma-next
enum JobStatus {
  @@type("pg/text@1")
  PENDING = "pending"
  FINNISH = "finnish"
}
model Job {
  id Uuid @id @default(uuid())
  goal      String
  equipment String
  availableTime String
  status  JobStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAtString()
}

model JobResult {
  id Uuid @id @default(uuid())
  plan      String
  jobId Uuid
  job Job @relation(fields: [jobId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAtString()
}
