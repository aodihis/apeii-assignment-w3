// use prisma-next
enum JobStatus {
  @@type("pg/text@1")
  PENDING = "pending"
  COMPLETED = "completed"
  FAILED = "failed"
}
model Job {
  id String @id @default(uuid())
  goal      String
  equipment String
  availableTime String
  status  JobStatus @default(PENDING)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model JobResult {
  id String @id @default(uuid())
  plan      String
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
