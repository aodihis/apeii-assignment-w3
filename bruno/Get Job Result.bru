meta {
  name: Get Job Result
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/study-guides/{{jobId}}
  body: none
  auth: none
}

vars:pre-request {
  jobId: job-id
}

tests {
  test("returns a job result response", function() {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });
  
  test("returns one study guide or null", function() {
    const body = res.getBody();
    expect(body).to.have.property("result");
  });
}
